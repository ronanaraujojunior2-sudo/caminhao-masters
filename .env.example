# =====================================================================
# CAMINHÃO MASTERS — VARIÁVEIS DE AMBIENTE (modelo)
# Copie para ".env" SOMENTE no seu computador. NUNCA envie o ".env" ao GitHub.
# =====================================================================

# ---------- FRONT-END (valores públicos, vão para web/js/config.js) ----------
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase > Project Settings > API Keys > Publishable key (ou "anon public")
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Domínio interno dos logins (igual ao segredo AUTH_EMAIL_DOMAIN das funções)
AUTH_EMAIL_DOMAIN=caminhaomasters.local
# Opcional (push): chave PÚBLICA VAPID
VAPID_PUBLIC_KEY=

# ---------- SEGREDOS DAS EDGE FUNCTIONS (Supabase > Edge Functions > Secrets) ----------
# Não coloque estes valores no código. Cadastre-os no painel do Supabase.
# AUTH_EMAIL_DOMAIN=caminhaomasters.local
# BOOTSTRAP_TOKEN=um-texto-aleatorio-com-pelo-menos-16-caracteres   (APAGUE após criar o 1º admin)
# VAPID_PUBLIC_KEY=...            (opcional, push)
# VAPID_PRIVATE_KEY=...           (opcional, push — SECRETO)
# VAPID_SUBJECT=mailto:ti@suaempresa.com.br
# PUSH_WEBHOOK_SECRET=texto-aleatorio  (opcional, push)
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente nas funções.

# ---------- BACKUP AUTOMÁTICO (GitHub > Settings > Secrets and variables > Actions) ----------
# SUPABASE_DB_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# BACKUP_SENHA=frase-longa-para-criptografar-os-backups
